---
// "Not vibe coding": the same five questions answered both ways, each of ours with a way to check it.
const { p } = Astro.props;
---
<section class="notvibe" aria-labelledby="nv-title">
  <div class="wrap">
    <p class="eyebrow">{p.eyebrow}</p>
    <h2 id="nv-title">{p.title}</h2>
    <p class="section-intro">{p.intro}</p>

    <div class="nv-board" role="table" aria-labelledby="nv-title">
      <div class="nv-row nv-head" role="row">
        <span role="columnheader" class="nv-topic-h"></span>
        <span role="columnheader" class="nv-vibe-h">{p.cols.vibe}</span>
        <span role="columnheader" class="nv-ours-h">{p.cols.ours}</span>
      </div>
      {p.rows.map((row: { topic: string; vibe: string; ours: string; proof: string; href?: string }, i: number) => (
        <div class="nv-row" role="row" style={`--i:${i}`}>
          <span class="nv-topic" role="rowheader"><em>{String(i + 1).padStart(2, '0')}</em>{row.topic}</span>
          <div class="nv-vibe" role="cell">
            <span class="nv-tag">{p.cols.vibe}</span>
            <p>{row.vibe}</p>
          </div>
          <div class="nv-ours" role="cell">
            <span class="nv-tag">{p.cols.ours}</span>
            <p>{row.ours}</p>
            <p class="nv-proof"><span>{p.cols.proof}:</span> {row.href ? <a href={row.href} data-cta="notvibe-proof">{row.proof} →</a> : row.proof}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .notvibe { padding: 5.5rem 0; border-top: 1px solid var(--line);
    background: radial-gradient(ellipse 50% 60% at 80% 40%, rgba(255, 176, 0, 0.07), transparent 70%), #121214; }
  .notvibe h2 { max-width: 900px; text-wrap: balance; }
  .nv-board { margin-top: 2.75rem; display: grid; gap: 0.6rem; }
  .nv-row { display: grid; grid-template-columns: 11rem minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 0.6rem; align-items: stretch; }
  .nv-head { padding-bottom: 0.2rem; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .nv-vibe-h { color: rgba(255, 255, 255, 0.42); padding-left: 1.2rem; }
  .nv-ours-h { color: var(--accent-lightest); padding-left: 1.2rem; }
  .nv-topic { display: grid; align-content: center; gap: 0.3rem; padding: 1rem 0; color: #fff; font-weight: 750; font-size: 1.08rem; }
  .nv-topic em { font: 600 0.75rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; font-style: normal; color: var(--accent); }
  .nv-vibe, .nv-ours { position: relative; min-width: 0; padding: 1.1rem 1.2rem 1.1rem 2.9rem; border-radius: 10px; }
  .nv-vibe { border: 1px dashed rgba(255, 255, 255, 0.14); background: rgba(255, 255, 255, 0.015); }
  .nv-vibe p { margin: 0; color: rgba(255, 255, 255, 0.5); font-size: 0.98rem; line-height: 1.5; }
  .nv-vibe::before, .nv-ours::before { position: absolute; left: 1rem; top: 1.1rem; width: 1.2rem; height: 1.2rem; display: grid; place-items: center;
    border-radius: 50%; font: 800 0.72rem/1 var(--sans); }
  .nv-vibe::before { content: '×'; color: #ff7a7a; border: 1px solid rgba(255, 93, 93, 0.45); font-size: 0.9rem; }
  .nv-ours { border: 1px solid rgba(255, 209, 102, 0.3); background: linear-gradient(90deg, rgba(255, 176, 0, 0.09), rgba(255, 176, 0, 0.02)); }
  .nv-ours::before { content: '✓'; color: var(--accent-ink); background: var(--accent); }
  .nv-ours > p:not(.nv-proof) { margin: 0; color: #fff; font-size: 1.02rem; line-height: 1.5; }
  .nv-proof { margin: 0.6rem 0 0; color: var(--muted); font-size: 0.85rem; }
  .nv-proof span { color: rgba(255, 255, 255, 0.45); }
  .nv-proof a { color: var(--accent-lightest); }
  .nv-tag { display: none; }
  @media (max-width: 860px) {
    .nv-head { display: none; }
    .nv-row { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; padding-top: 1rem; }
    .nv-row + .nv-row { border-top: 1px solid var(--line); }
    .nv-topic { padding: 0 0 0.2rem; grid-auto-flow: column; justify-content: start; align-items: baseline; gap: 0.6rem; }
    .nv-tag { display: block; margin-bottom: 0.3rem; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
    .nv-vibe .nv-tag { color: rgba(255, 255, 255, 0.4); }
    .nv-ours .nv-tag { color: var(--accent-lightest); }
  }
</style>
