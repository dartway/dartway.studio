---
// "Not vibe coding": five questions answered both ways in one line each, and two places to check it yourself.
const { p } = Astro.props;
---
<section class="notvibe" aria-labelledby="nv-title">
  <div class="wrap">
    <p class="eyebrow">{p.eyebrow}</p>
    <h2 id="nv-title">{p.title}</h2>
    <p class="section-intro">{p.intro}</p>

    <div class="nv-board" role="table" aria-labelledby="nv-title">
      <div class="nv-row nv-head" role="row">
        <span role="columnheader"></span>
        <span role="columnheader" class="nv-vibe-h">{p.cols.vibe}</span>
        <span role="columnheader" class="nv-ours-h">{p.cols.ours}</span>
      </div>
      {p.rows.map((row: { topic: string; vibe: string; ours: string }) => (
        <div class="nv-row" role="row">
          <span class="nv-topic" role="rowheader">{row.topic}</span>
          <p class="nv-vibe" role="cell"><span class="nv-tag">{p.cols.vibe}</span>{row.vibe}</p>
          <p class="nv-ours" role="cell"><span class="nv-tag">{p.cols.ours}</span>{row.ours}</p>
        </div>
      ))}
    </div>

    <p class="nv-check">
      <span>{p.check.label}:</span>
      {p.check.links.map((l: { text: string; href: string }) => <a href={l.href} data-cta="notvibe-proof">{l.text} →</a>)}
    </p>
  </div>
</section>

<style is:global>
  .notvibe h2 { max-width: 900px; text-wrap: balance; }
  .nv-board { margin-top: 2.5rem; border-bottom: 1px solid var(--line); }
  .nv-row { display: grid; grid-template-columns: 11rem minmax(0, 1fr) minmax(0, 1.25fr); gap: 1.5rem; align-items: baseline;
    padding: 1.05rem 0; border-top: 1px solid var(--line); }
  .nv-head { padding: 0 0 0.7rem; border-top: 0; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .nv-vibe-h { color: rgba(255, 255, 255, 0.4); }
  .nv-ours-h { color: var(--accent-lightest); }
  .nv-topic { color: #fff; font-weight: 700; font-size: 1.02rem; }
  .nv-vibe, .nv-ours { position: relative; margin: 0; padding-left: 1.6rem; min-width: 0; line-height: 1.45; }
  .nv-vibe { color: rgba(255, 255, 255, 0.45); font-size: 1rem; }
  .nv-ours { color: #fff; font-size: 1.08rem; font-weight: 600; }
  .nv-vibe::before, .nv-ours::before { position: absolute; left: 0; top: 0.05em; font-weight: 800; }
  .nv-vibe::before { content: '×'; color: rgba(255, 255, 255, 0.35); }
  .nv-ours::before { content: '✓'; color: var(--accent); }
  .nv-tag { display: none; }
  .nv-check { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin: 1.4rem 0 0; font-size: 0.95rem; }
  .nv-check span { color: var(--muted); }
  .nv-check a { color: var(--accent-lightest); font-weight: 600; }
  @media (max-width: 760px) {
    .nv-head { display: none; }
    .nv-row { grid-template-columns: minmax(0, 1fr); gap: 0.45rem; }
    .nv-tag { display: block; margin-bottom: 0.15rem; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
    .nv-vibe .nv-tag { color: rgba(255, 255, 255, 0.35); }
    .nv-ours .nv-tag { color: var(--accent-lightest); }
  }
</style>
