---
import SiteLayout from './SiteLayout.astro';
import Contact from './Contact.astro';
import Replica from './Replica.astro';
import { caseStudies } from '../data/caseStudies';
const { project, lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const content = project.locales[lang];
const prefix = ru ? '/ru' : '';
const live = ['Published', 'В магазинах'].includes(content.status);
const idx = caseStudies.findIndex((p) => p.slug === project.slug);
const next = caseStudies[(idx + 1) % caseStudies.length];
const nextContent = next.locales[lang as 'en' | 'ru'];
const screens = content.visuals.filter((v: any) => v.screen);
const images = content.visuals.filter((v: any) => !v.screen && v.src);
const sections = [
  { id: 'challenge', title: ru ? 'Задача' : 'The challenge', paragraphs: content.challenge },
  { id: 'delivery', title: ru ? 'Что умеет приложение' : 'What the app does', paragraphs: content.ourWork },
  ...(content.hardPart ? [{ id: 'hard-part', eyebrow: ru ? 'Самое сложное' : 'The hard part', title: content.hardPart.title, paragraphs: content.hardPart.text }] : []),
  { id: 'result', title: ru ? 'Где сейчас' : 'Where it is now', paragraphs: content.result },
];
---
<SiteLayout
  lang={lang}
  title={`${content.title} — DartWay`}
  description={content.summary}
  image={project.cover || images[0]?.src}
>
  <article class="case" style={`--case-accent:${project.accent || '#ffb000'}`}>
    <header class="wrap case-intro">
      <a class="back-link" href={`${prefix}/work/`}>← {ru ? 'Все проекты' : 'All projects'}</a>
      <p class="eyebrow">{content.category}</p>
      <h1>{content.title}</h1>
      <p class="lead">{content.summary}</p>
      <div class="case-meta">
        <span class:list={['work-status', live ? 'st-live' : 'st-soon']}>{content.status}</span>
        <span class="case-meta-detail">{content.statusDetail}</span>
      </div>
      {content.highlights?.length > 0 && (
        <ul class="case-highlights">{content.highlights.map((h: string) => <li>{h}</li>)}</ul>
      )}
      {content.links?.length > 0 && (
        <div class="case-store-links">
          {content.links.map((link: { label: string; href: string }) => (
            <a class="btn" href={link.href} data-cta={`case-store-${project.slug}`}>
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      )}
    </header>

    {screens.length > 0 && (
      <section class="case-screens" aria-label={ru ? 'Экраны приложения' : 'App screens'}>
        <div class="wrap">
          <div class="case-screens-row">
            {screens.map((visual: any) => (
              <figure>
                <Replica screen={visual.screen} lang={lang} label={visual.alt} />
                <figcaption>{visual.caption}</figcaption>
              </figure>
            ))}
          </div>
          {content.screensNote && <p class="case-screens-note">{content.screensNote}</p>}
        </div>
      </section>
    )}

    {images.length > 0 && (
      <section class="wrap case-visuals" aria-label={ru ? 'Материалы проекта' : 'Project visuals'}>
        {images.map((visual: any) => (
          <figure class:list={[{ wide: visual.wide }]}>
            <img src={visual.src} alt={visual.alt} loading="lazy" />
            <figcaption>{visual.caption}</figcaption>
          </figure>
        ))}
      </section>
    )}

    <div class="wrap case-body">
      <div class="case-story">
        {sections.map(section => (
          <section id={section.id} class:list={[{ 'hard-part': section.eyebrow }]}>
            {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
          </section>
        ))}
      </div>
      <aside class="case-facts">
        <h2>{ru ? 'В проекте' : 'Inside the project'}</h2>
        <ul>{content.features.map((feature: string) => <li>{feature}</li>)}</ul>
      </aside>
    </div>

    <nav class="wrap case-next" aria-label={ru ? 'Следующий проект' : 'Next project'}>
      <a href={`${prefix}/work/${next.slug}/`} style={`--case-accent:${next.accent || '#ffb000'}`} data-cta={`case-next-${next.slug}`}>
        <small>{ru ? 'Следующий проект' : 'Next project'}</small>
        <strong>{nextContent.title} <span aria-hidden="true">→</span></strong>
        <span>{nextContent.category}</span>
      </a>
    </nav>
  </article>
  <Contact lang={lang} />
</SiteLayout>
