---
import SiteLayout from './SiteLayout.astro';
import Contact from './Contact.astro';
const { project, lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const content = project.locales[lang];
const prefix = ru ? '/ru' : '';
const sections = [
  { id: 'challenge', title: ru ? 'Продуктовая задача' : 'The product challenge', paragraphs: content.challenge },
  { id: 'team', title: ru ? 'Команда и ответственность' : 'The team and responsibilities', paragraphs: content.clientTeam },
  { id: 'delivery', title: ru ? 'Что мы реализовали' : 'What we delivered', paragraphs: content.ourWork },
  { id: 'collaboration', title: ru ? 'Как строилась работа' : 'How the work came together', paragraphs: content.collaboration },
  { id: 'result', title: ru ? 'Результат и текущий этап' : 'The result and current stage', paragraphs: content.result },
];
---
<SiteLayout
  lang={lang}
  title={`${content.title} — DartWay`}
  description={content.summary}
  image={content.visuals?.[0]?.src}
>
  <article style={`--case-accent:${project.accent || '#ffb000'}`}>
    <header class="wrap case-intro">
      <a class="back-link" href={`${prefix}/work/`}>← {ru ? 'Все проекты' : 'All projects'}</a>
      <p class="eyebrow">{content.category}</p>
      <h1>{content.title}</h1>
      <p class="lead">{content.summary}</p>
      <div class="case-status">
        <strong>{content.status}</strong>
        <p>{content.statusDetail}</p>
      </div>
      {content.links?.length > 0 && (
        <div class="case-store-links">
          {content.links.map((link: { label: string; href: string }) => (
            <a class="btn" href={link.href} data-cta={`case-store-${project.slug}`}>
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      )}
    </header>

    {content.visuals?.length > 0 && (
      <section class="wrap case-visuals" aria-label={ru ? 'Материалы проекта' : 'Project visuals'}>
        {content.visuals.map((visual: any) => (
          <figure class:list={[{ wide: visual.wide }]}>
            <img src={visual.src} alt={visual.alt} loading="lazy" />
            <figcaption>{visual.caption}</figcaption>
          </figure>
        ))}
      </section>
    )}

    <div class="wrap case-body">
      <aside class="case-sidebar">
        <h2>{ru ? 'В проекте' : 'Inside the project'}</h2>
        <ul>{content.features.map((feature: string) => <li>{feature}</li>)}</ul>
        <nav aria-label={ru ? 'Разделы кейса' : 'Case sections'}>
          {sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}
        </nav>
      </aside>
      <div class="case-story">
        {sections.map(section => (
          <section id={section.id}>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
          </section>
        ))}
      </div>
    </div>
  </article>
  <Contact lang={lang} />
</SiteLayout>
