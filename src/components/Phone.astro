---
/** A phone frame showing one app screen: a 375×812 page from the app's published design, scaled to the frame width. */
const { src, label, decorative = false } = Astro.props;
---
<div class="phone" role={decorative ? undefined : 'img'} aria-label={decorative ? undefined : label} aria-hidden={decorative ? 'true' : undefined}>
  <div class="phone-screen">
    <iframe src={src} title={label || 'App screen'} width="375" height="812" loading="lazy" tabindex="-1" aria-hidden="true" scrolling="no"></iframe>
  </div>
</div>
<script>
  const fit = new ResizeObserver((entries) => {
    for (const e of entries) (e.target as HTMLElement).style.setProperty('--s', String(e.contentRect.width / 375));
  });
  document.querySelectorAll('.phone-screen').forEach((el) => fit.observe(el));
</script>
