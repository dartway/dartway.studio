---
// Who it is for: the visitor picks the segment that sounds like them and sees their case,
// their worry and our answer; the button prices the project with that segment's answers filled in.
const { s } = Astro.props;
---
<section class="wrap segments seg" aria-labelledby="seg-title">
  <p class="eyebrow">{s.eyebrow}</p>
  <h2 id="seg-title">{s.title}</h2>
  <p class="section-intro">{s.intro}</p>

  <div class="seg-tabs" role="tablist" aria-label={s.eyebrow}>
    {s.items.map((it: any, i: number) => (
      <button type="button" role="tab" class="seg-tab" id={`seg-tab-${i}`} aria-controls={`seg-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-cta="segment-pick">
        <span class="seg-num">{String(i + 1).padStart(2, '0')}</span>
        <strong>{it.title}</strong>
        <span>{it.text}</span>
      </button>
    ))}
  </div>

  {s.items.map((it: any, i: number) => (
    <div class="seg-panel" role="tabpanel" id={`seg-panel-${i}`} aria-labelledby={`seg-tab-${i}`} hidden={i !== 0}>
      <div class="seg-case">
        <div>
          <p class="seg-label">{s.labels.situation}</p>
          <p class="seg-situation">{it.situation}</p>
        </div>
        <div>
          <p class="seg-label">{s.labels.gain}</p>
          <p class="seg-gain">{it.gain}</p>
        </div>
      </div>
      <div class="seg-objection">
        <p class="seg-label">{s.labels.fear}</p>
        <blockquote>{it.fear}</blockquote>
        <p class="seg-label seg-label-ours">{s.labels.answer}</p>
        <p class="seg-answer">{it.answer}</p>
        <a class="btn" href="#contact" data-brief-preset={JSON.stringify(it.preset)} data-cta="segment-price">{s.labels.cta} →</a>
      </div>
    </div>
  ))}
</section>

<script is:inline>
  (() => {
    const tabs = [...document.querySelectorAll('.seg-tab')];
    const pick = (i, focus) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
      });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('keydown', (e) => {
        const d = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
        if (d) { e.preventDefault(); pick((i + d + tabs.length) % tabs.length, true); }
      });
    });
  })();
</script>

<style is:global>
  .seg-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.9rem; margin-top: 2rem; }
  .seg-tab { position: relative; display: grid; align-content: start; gap: 0.45rem; text-align: left; cursor: pointer; padding: 1.2rem 1.25rem 1.3rem;
    border: 1px solid var(--line); border-radius: 12px; background: rgba(255, 255, 255, 0.02); color: var(--muted); font: inherit;
    transition: border-color 0.2s, background 0.2s, transform 0.2s; }
  .seg-tab strong { color: #fff; font-size: 1.1rem; line-height: 1.3; }
  .seg-tab span:last-child { font-size: 0.92rem; line-height: 1.5; }
  .seg-num { color: rgba(255, 255, 255, 0.4); font: 600 0.75rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .seg-tab:hover { border-color: rgba(255, 209, 102, 0.55); }
  .seg-tab[aria-selected='true'] { border-color: var(--accent); background: rgba(255, 176, 0, 0.08); }
  .seg-tab[aria-selected='true'] .seg-num { color: var(--accent); }
  .seg-tab[aria-selected='true']::after { content: ''; position: absolute; left: 50%; bottom: -0.95rem; width: 14px; height: 14px; margin-left: -7px;
    transform: rotate(45deg); background: #17150f; border-left: 1px solid var(--accent); border-top: 1px solid var(--accent); z-index: 2; }
  .seg-tab:focus-visible { outline: 2px solid var(--accent-lightest); outline-offset: 3px; }
  .seg-panel { position: relative; margin-top: 0.9rem; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 0;
    border: 1px solid rgba(255, 176, 0, 0.4); border-radius: 12px; overflow: hidden;
    background: #17150f; animation: seg-in 0.35s ease-out; }
  .seg-panel[hidden] { display: none; }
  @keyframes seg-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .seg-case { display: grid; align-content: start; gap: 1.6rem; padding: 2rem; border-right: 1px solid rgba(255, 255, 255, 0.08); }
  .seg-objection { padding: 2rem; display: grid; align-content: start; justify-items: start; }
  .seg-label { margin: 0 0 0.45rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
  .seg-label-ours { color: var(--accent-lightest); margin-top: 1.4rem; }
  .seg-situation { margin: 0; color: rgba(255, 255, 255, 0.86); font-size: 1.05rem; }
  .seg-gain { margin: 0; color: #fff; font-size: clamp(1.25rem, 2.2vw, 1.6rem); font-weight: 750; line-height: 1.3; text-wrap: balance; }
  .seg-objection blockquote { margin: 0; padding: 0.2rem 0 0.2rem 1rem; border-left: 2px solid rgba(255, 255, 255, 0.25); color: rgba(255, 255, 255, 0.86); font-size: 1.1rem; font-style: italic; }
  .seg-answer { margin: 0 0 1.5rem; color: rgba(255, 255, 255, 0.86); }
  @media (max-width: 860px) {
    .seg-tabs { grid-template-columns: 1fr; gap: 0.6rem; }
    .seg-tab { padding: 1rem 1.1rem; }
    .seg-tab span:last-child { display: none; }
    .seg-tab[aria-selected='true']::after { display: none; }
    .seg-panel { grid-template-columns: 1fr; }
    .seg-case { padding: 1.4rem; border-right: 0; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
    .seg-objection { padding: 1.4rem; }
  }
  @media (prefers-reduced-motion: reduce) { .seg-panel { animation: none; } .seg-tab { transition: none; } }
</style>
