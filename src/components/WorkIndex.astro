---
import SiteLayout from './SiteLayout.astro';
import WorkGrid from './WorkGrid.astro';
import Contact from './Contact.astro';
const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? 'Проекты DartWay — разработка и развитие приложений' : 'DartWay projects — apps, delivery and ongoing development';
const description = ru ? 'Подробные истории проектов: задачи, роли команд, реализация и текущий результат.' : 'Detailed project stories: the brief, team responsibilities, implementation and the current result.';
---
<SiteLayout lang={lang} title={title} description={description}>
  <section class="wrap page-intro"><p class="eyebrow">{ru ? 'Портфолио' : 'Our work'}</p><h1>{ru ? 'Наши проекты' : 'Our projects'}</h1><p class="lead">{description}</p></section>
  <section class="wrap portfolio"><WorkGrid lang={lang} /></section>
  <Contact lang={lang} />
</SiteLayout>
