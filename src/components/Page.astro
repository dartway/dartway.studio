---
import SiteLayout from './SiteLayout.astro';
import WorkGrid from './WorkGrid.astro';
import Contact from './Contact.astro';
import FactoryLine from './FactoryLine.astro';
import SplitRoles from './SplitRoles.astro';
import { caseStudies } from '../data/caseStudies';
const { t, agency = false } = Astro.props;
const prefix = t.lang === 'ru' ? '/ru' : '';
const published = caseStudies.filter((c) => c.locales.en.status === 'Published').length;
const stats = [
  { value: caseStudies.length, label: t.stats.inProgress },
  { value: published, label: t.stats.published },
];
// The price ticket: the builder's first question on the first screen.
const ru = t.lang === 'ru';
const q = ru
  ? { tag: 'Заявка на цену', price: 'Фиксированная цена', due: 'на следующий рабочий день', q: 'Что у вас есть?',
      opts: [['Макет в Figma', 'цена прямо по экранам'], ['Прототип', 'кликабельный или в коде'], ['Только описание', 'объём соберём вместе'], ['Готовое приложение', 'осмотр кода, два пути']],
      note: 'Ещё три клика — и письмо готово. Отправляете сами: без форм и созвонов.' }
  : { tag: 'Price ticket', price: 'Your fixed price', due: 'by the next business day', q: 'What do you have?',
      opts: [['Figma mockup', 'priced straight from the screens'], ['Prototype', 'clickable or in code'], ['Just a brief', 'we shape the scope together'], ['An existing app', 'code review, two paths']],
      note: 'Three more taps and your message is written. You send it yourself: no forms, no calls.' };
const icons = [
  '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 8h16M9 8v13"/>',
  '<path d="M6 3l12 8-5 1.5L10 18z"/>',
  '<path d="M6 3h9l3 3v15H6z"/><path d="M9 11h6M9 15h6"/>',
  '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
];
---
<SiteLayout
  lang={t.lang}
  title={agency ? `${t.agency.title} — DartWay` : t.title}
  description={agency ? t.agency.description : t.description}
>
  <section class="hero delivery-hero has-ticket">
    <p class="eyebrow">{agency ? t.agency.eyebrow : t.hero.eyebrow}</p>
    <h1>{agency ? t.agency.title : t.hero.title}</h1>
    <p class="lead">{agency ? t.agency.lead : t.hero.lead}</p>
    <div class="actions">
      <a class="btn" href="#contact" data-cta="hero-contact">{t.hero.primary}</a>
      <a class="more" href={`${prefix}/work/`} data-cta="hero-work">{t.hero.secondary}</a>
    </div>
    <div class="meta">
      {t.hero.meta.map((item: string) => <span>{item}</span>)}
    </div>
    {!agency && (
      <div class="stats">
        {stats.map((st) => <div class="stat"><strong>{st.value}</strong><span>{st.label}</span></div>)}
      </div>
    )}
    <aside class="ticket" aria-labelledby="ticket-q">
      <div class="ticket-head">
        <span>{q.tag}</span>
        <span class="ticket-steps" aria-hidden="true"><i class="on"></i><i></i><i></i><i></i></span>
        <span>1 / 4</span>
      </div>
      <p class="ticket-price">{q.price}</p>
      <p class="ticket-due" data-due>{q.due}</p>
      <p class="ticket-q" id="ticket-q">{q.q}</p>
      <div class="ticket-opts">
        {q.opts.map(([label, sub], i) => (
          <a class="ticket-opt" href="#contact" data-hero-pick={i} data-cta="hero-ticket">
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[i]} />
            <strong>{label}</strong>
            <span>{sub}</span>
          </a>
        ))}
      </div>
      <p class="ticket-note">{q.note}</p>
    </aside>
  </section>


  {!agency && <FactoryLine f={t.factory} />}

  {!agency && (
    <section class="wrap pillars">
      <p class="eyebrow">{t.pillars.eyebrow}</p>
      <h2>{t.pillars.title}</h2>
      <div class="delivery-steps pillar-grid">
        {t.pillars.items.map((item: { title: string; text: string }) => (
          <article><h3>{item.title}</h3><p>{item.text}</p></article>
        ))}
      </div>
    </section>
  )}


  {agency && (
    <section class="wrap agency-roles">
      <p class="eyebrow">{t.agency.eyebrow}</p>
      <h2>{t.agency.heading}</h2>
      <p class="section-intro">{t.agency.intro}</p>
      <div class="roles-grid">
        <article>
          <h3>{t.agency.yourTitle}</h3>
          <ul>{t.agency.yourItems.map((item: string) => <li>{item}</li>)}</ul>
        </article>
        <article class="our-role">
          <h3>{t.agency.ourTitle}</h3>
          <ul>{t.agency.ourItems.map((item: string) => <li>{item}</li>)}</ul>
        </article>
      </div>
    </section>
  )}

  <section class="wrap work-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t.work.eyebrow}</p>
        <h2>{t.work.title}</h2>
      </div>
      <a class="more" href={`${prefix}/work/`}>{t.work.all}</a>
    </div>
    <p class="section-intro">{t.work.text}</p>
    <WorkGrid lang={t.lang} limit={agency ? 4 : 3} />
  </section>


  {!agency && (
    <section class="wrap segments">
      <p class="eyebrow">{t.segments.eyebrow}</p>
      <h2>{t.segments.title}</h2>
      <div class="delivery-steps pillar-grid">
        {t.segments.items.map((item: { title: string; text: string }) => (
          <article><h3>{item.title}</h3><p>{item.text}</p></article>
        ))}
      </div>
    </section>
  )}

  {agency ? (
    <>
  <section class="wrap" id="delivery">
    <h2>{t.delivery.title}</h2>
    <p class="section-intro">{t.delivery.intro}</p>
    <div class="delivery-steps">
      {t.delivery.steps.map((step: { title: string; text: string }) => (
        <article><h3>{step.title}</h3><p>{step.text}</p></article>
      ))}
    </div>
  </section>


  <section class="wrap ownership">
    <h2>{t.ownership.title}</h2>
    <p>{t.ownership.text}</p>
  </section>
    </>
  ) : <SplitRoles lang={t.lang} />}
  {!agency && (
    <section class="wrap founder">
      <img class="founder-photo" src="/img/founder.jpg" alt={t.founder.name} width="360" height="360" loading="lazy" decoding="async" />
      <div>
        <p class="eyebrow">{t.founder.eyebrow}</p>
        <h2>{t.founder.name}</h2>
        <p class="founder-role">{t.founder.role}</p>
        {t.founder.text.map((line: string) => <p>{line}</p>)}
        <div class="founder-links">
          {t.founder.links.map((l: { label: string; href: string }) => <a class="more" href={l.href} data-cta="founder-link">{l.label}</a>)}
        </div>
      </div>
    </section>
  )}

  {!agency && (
    <section class="wrap faq" id="faq">
      <p class="eyebrow">{t.faq.eyebrow}</p>
      <h2>{t.faq.title}</h2>
      <div class="faq-list">
        {t.faq.items.map((item: { q: string; a: string }) => (
          <details data-cta="faq"><summary>{item.q}</summary><p>{item.a}</p></details>
        ))}
      </div>
    </section>
  )}
  <Contact lang={t.lang} />
</SiteLayout>
