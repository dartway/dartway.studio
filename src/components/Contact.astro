---
// Price request builder: four taps write the message for the visitor, with the day the price is due.
// Nothing is sent from the page: the buttons open the visitor's email or Telegram with the text ready.
const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const EMAIL = 'evgenii@dartway.studio';
const TG = 'https://t.me/eu_novikov';

const t = ru
  ? {
      eyebrow: 'Цена проекта',
      title: ['Четыре клика — фиксированная цена ', 'на следующий рабочий день', ''],
      lead: 'Отметьте, что у вас есть. Письмо мы напишем за вас: добавьте ссылку и отправьте. Евгений вернёт объём, цену и срок.',
      groups: [
        { key: 'have', q: 'Что у вас есть?', opts: ['Макет в Figma', 'Прототип', 'Только описание', 'Готовое приложение'] },
        { key: 'platforms', q: 'Платформы', multi: true, opts: ['iOS', 'Android', 'Веб'] },
        { key: 'size', q: 'Размер', opts: ['Несколько экранов', '10–30 экранов', 'Больше 30', 'Пока не знаем'] },
        { key: 'for', q: 'Для кого', opts: ['Для нашего заказчика', 'Наш продукт'] },
      ],
      existing: 'Начнём с осмотра кода: продолжать или пересобрать — с ценой каждого пути.',
      link: 'Ссылка на макет или описание',
      linkHint: 'необязательно',
      preview: 'Ваше письмо',
      email: 'Отправить письмом',
      tg: 'Скопировать и открыть Telegram',
      copied: 'Текст скопирован — вставьте в чат',
      note: 'Со страницы ничего не уходит, пока вы сами не отправите. Без форм и созвонов.',
      or: 'Или напрямую:',
      subject: 'Расчёт проекта',
      hello: 'Здравствуйте, Евгений!',
      ask: 'Хотим фиксированную цену и срок.',
      labels: { have: 'Что есть', platforms: 'Платформы', size: 'Размер', for: 'Для кого', link: 'Макет' },
      about: 'Пара слов о приложении:',
      sign: '(имя, компания)',
      none: '—',
      dock: { tag: 'Фиксированная цена', next: 'Дальше →', ready: 'Письмо готово', go: 'Проверить и отправить →', close: 'Скрыть' },
    }
  : {
      eyebrow: 'Price your project',
      title: ['Four taps. A fixed price ', 'by the next business day', ''],
      lead: 'Pick what you have. We write the message for you: add a link and send it. Evgenii replies with the scope, the price and the timeline.',
      groups: [
        { key: 'have', q: 'What do you have?', opts: ['Figma mockup', 'Prototype', 'Just a brief', 'An existing app'] },
        { key: 'platforms', q: 'Platforms', multi: true, opts: ['iOS', 'Android', 'Web'] },
        { key: 'size', q: 'Size', opts: ['A few screens', '10–30 screens', '30+ screens', 'Not sure yet'] },
        { key: 'for', q: "It's for", opts: ['Our client', 'Our own product'] },
      ],
      existing: 'We start with a code review: continue or rebuild, with a price for each.',
      link: 'Link to the design or brief',
      linkHint: 'optional',
      preview: 'Your message',
      email: 'Send by email',
      tg: 'Copy and open Telegram',
      copied: 'Copied — paste it into the chat',
      note: 'Nothing leaves this page until you send it yourself. No forms, no calls.',
      or: 'Or directly:',
      subject: 'Price request',
      hello: 'Hi Evgenii,',
      ask: "We'd like a fixed price and timeline.",
      labels: { have: 'What we have', platforms: 'Platforms', size: 'Size', for: "It's for", link: 'Design' },
      about: 'A few words about the app:',
      sign: '(name, company)',
      none: '—',
      dock: { tag: 'Your fixed price', next: 'Next →', ready: 'Your message is ready', go: 'Review and send →', close: 'Hide' },
    };
const cfg = { ru, email: EMAIL, t };
---
<section class="brief" id="contact" aria-labelledby="brief-title">
  <div class="wrap brief-grid">
    <div class="brief-copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="brief-title">{t.title[0]}<span class="brief-due" data-due>{t.title[1]}</span>{t.title[2]}</h2>
      <p class="brief-lead">{t.lead}</p>
      <p class="brief-note">{t.note}</p>
      <p class="brief-direct">{t.or} <a href={`mailto:${EMAIL}`} data-cta="contact-email">{EMAIL}</a> · <a href={TG} data-cta="contact-telegram">Telegram</a></p>
    </div>

    <div class="brief-card">
      {t.groups.map((g) => (
        <fieldset class="brief-q" data-key={g.key} data-multi={g.multi ? '1' : ''}>
          <legend>{g.q}</legend>
          <div class="brief-opts">
            {g.opts.map((o) => (
              <button type="button" class="brief-chip" aria-pressed="false" data-cta="brief-chip">{o}</button>
            ))}
          </div>
        </fieldset>
      ))}
      <p class="brief-existing" hidden>{t.existing}</p>
      <label class="brief-link">
        <span>{t.link} <em>{t.linkHint}</em></span>
        <input type="url" inputmode="url" placeholder="figma.com/…" autocomplete="off" />
      </label>
      <div class="brief-preview">
        <span>{t.preview}</span>
        <pre data-preview></pre>
      </div>
      <div class="brief-actions">
        <a class="btn" data-send href={`mailto:${EMAIL}`} data-cta="brief-email">{t.email}</a>
        <a class="more brief-tg" data-tg href={TG} target="_blank" rel="noopener" data-cta="brief-telegram">{t.tg}</a>
      </div>
      <p class="brief-copied" data-copied hidden>{t.copied}</p>
    </div>
  </div>
</section>

<!-- The price ticket travels with the reader: the next open question, answered from anywhere on the page. -->
<div class="dock" data-dock role="region" aria-label={t.dock.tag} inert>
  <div class="dock-in">
    <p class="dock-meta"><span>{t.dock.tag}</span> <strong data-due>{t.title[1]}</strong></p>
    <div class="dock-ask">
      <p class="dock-q" data-dock-q></p>
      <div class="dock-opts" data-dock-opts></div>
    </div>
    <span class="dock-step" aria-hidden="true"><span class="dock-segs"><i></i><i></i><i></i><i></i></span><span data-dock-n>0 / 4</span></span>
    <button type="button" class="dock-close" data-dock-close aria-label={t.dock.close}>×</button>
  </div>
</div>

<script is:inline define:vars={{ cfg }}>
  (() => {
    const root = document.getElementById('contact');
    if (!root) return;
    const { t, ru, email } = cfg;
    const state = { have: [], platforms: [], size: [], for: [] };
    const link = root.querySelector('.brief-link input');
    const pre = root.querySelector('[data-preview]');
    const send = root.querySelector('[data-send]');
    const tg = root.querySelector('[data-tg]');
    const existing = root.querySelector('.brief-existing');

    // The day the price is due: the next business day; on a weekend, Monday.
    const due = new Date();
    do { due.setDate(due.getDate() + 1); } while (due.getDay() === 0 || due.getDay() === 6);
    const dayRu = ['воскресенью', 'понедельнику', 'вторнику', 'среде', 'четвергу', 'пятнице', 'субботе'];
    const date = due.toLocaleDateString(ru ? 'ru-RU' : 'en-GB', { day: 'numeric', month: 'long' });
    const dueText = ru
      ? `к ${dayRu[due.getDay()]}, ${date}`
      : `by ${due.toLocaleDateString('en-GB', { weekday: 'long' })}, ${date}`;
    document.querySelectorAll('[data-due]').forEach((el) => { el.textContent = dueText; });

    function text() {
      const L = t.labels;
      const v = (k) => (state[k].length ? state[k].join(', ') : t.none);
      return [
        t.hello, '', t.ask, '',
        `${L.have}: ${v('have')}`,
        `${L.platforms}: ${v('platforms')}`,
        `${L.size}: ${v('size')}`,
        `${L.for}: ${v('for')}`,
        `${L.link}: ${link.value.trim() || t.none}`,
        '', t.about, '', '', t.sign,
      ].join('\n');
    }
    function subject() {
      const bits = [state.have[0], state.platforms.join('/')].filter(Boolean);
      return bits.length ? `${t.subject}: ${bits.join(', ')}` : t.subject;
    }
    function render() {
      const body = text();
      pre.textContent = body;
      send.href = `mailto:${email}?subject=${encodeURIComponent(subject())}&body=${encodeURIComponent(body)}`;
      existing.hidden = !state.have.includes(t.groups[0].opts[3]);
      // Guide: light up the first question still open; when all four are answered, the send button.
      const open = [...root.querySelectorAll('.brief-q')].find((fs) => !state[fs.dataset.key].length);
      root.querySelectorAll('.brief-q').forEach((fs) => fs.classList.toggle('is-next', fs === open));
      send.classList.toggle('is-ready', !open);
      renderDock();
    }

    // Dock: the same questions, one at a time, wherever the reader is.
    const dock = document.querySelector('[data-dock]');
    const dq = dock.querySelector('[data-dock-q]');
    const dopts = dock.querySelector('[data-dock-opts]');
    const dn = dock.querySelector('[data-dock-n]');
    const segs = dock.querySelectorAll('.dock-segs i');
    let stay = null; // a multi-choice question stays until "Next"
    function goToCard() {
      const card = root.querySelector('.brief-card');
      card.scrollIntoView({ behavior: 'smooth', block: 'start' });
      card.classList.remove('arrived'); void card.offsetWidth; card.classList.add('arrived');
    }
    function dockBtn(label, cls, onClick, pressed) {
      const b = document.createElement('button');
      b.type = 'button'; b.className = cls; b.textContent = label;
      if (pressed !== undefined) b.setAttribute('aria-pressed', String(pressed));
      b.addEventListener('click', onClick);
      return b;
    }
    function renderDock() {
      const qs = [...root.querySelectorAll('.brief-q')];
      const done = qs.filter((fs) => state[fs.dataset.key].length).length;
      dn.textContent = `${done} / ${qs.length}`;
      segs.forEach((s, i) => s.classList.toggle('on', i < done));
      const fs = qs.find((f) => f.dataset.key === stay) || qs.find((f) => !state[f.dataset.key].length);
      dopts.replaceChildren();
      dock.classList.toggle('is-ready', !fs);
      if (!fs) {
        dq.textContent = t.dock.ready;
        const go = dockBtn(t.dock.go, 'dock-go', goToCard);
        go.dataset.cta = 'dock-send';
        dopts.append(go);
        return;
      }
      dq.textContent = fs.querySelector('legend').textContent;
      fs.querySelectorAll('.brief-chip').forEach((chip) => {
        const b = dockBtn(chip.textContent.trim(), 'dock-chip', () => {
          if (fs.dataset.multi === '1') stay = fs.dataset.key;
          chip.click();
        }, chip.getAttribute('aria-pressed') === 'true');
        b.dataset.cta = 'dock-chip';
        dopts.append(b);
      });
      if (stay === fs.dataset.key && state[stay].length) {
        dopts.append(dockBtn(t.dock.next, 'dock-next', () => { stay = null; renderDock(); }));
      }
    }
    // Shown once the hero (or the page title) is behind, hidden again at the builder itself.
    let closed = false;
    try { closed = sessionStorage.getItem('dock-closed') === '1'; } catch (e) {}
    let topSeen = true;
    let atBuilder = false;
    const sync = () => {
      const on = !closed && !topSeen && !atBuilder;
      dock.classList.toggle('on', on);
      dock.inert = !on;
    };
    const top = document.querySelector('.hero .actions') || document.querySelector('h1');
    if ('IntersectionObserver' in window) {
      if (top) new IntersectionObserver(([e]) => { topSeen = e.isIntersecting || e.boundingClientRect.top > 0; sync(); }).observe(top);
      new IntersectionObserver(([e]) => { atBuilder = e.isIntersecting || e.boundingClientRect.top < 0; sync(); }, { rootMargin: '0px 0px -25% 0px' }).observe(root);
    }
    dock.querySelector('[data-dock-close]').addEventListener('click', () => {
      closed = true; sync();
      try { sessionStorage.setItem('dock-closed', '1'); } catch (e) {}
    });

    root.querySelectorAll('.brief-q').forEach((fs) => {
      const key = fs.dataset.key;
      const multi = fs.dataset.multi === '1';
      fs.querySelectorAll('.brief-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          const val = chip.textContent.trim();
          const on = chip.getAttribute('aria-pressed') !== 'true';
          if (!multi) fs.querySelectorAll('.brief-chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
          chip.setAttribute('aria-pressed', String(on));
          state[key] = multi
            ? (on ? [...state[key], val] : state[key].filter((x) => x !== val))
            : (on ? [val] : []);
          render();
        });
      });
    });
    link.addEventListener('input', render);

    // A segment's button fills in its answers (only where the visitor hasn't answered) and opens the builder.
    document.querySelectorAll('[data-brief-preset]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        let preset = {};
        try { preset = JSON.parse(a.dataset.briefPreset); } catch (err) {}
        Object.entries(preset).forEach(([key, i]) => {
          if (state[key] && state[key].length) return;
          const chip = root.querySelectorAll(`.brief-q[data-key="${key}"] .brief-chip`)[i];
          if (chip) chip.click();
        });
        goToCard();
        const next = root.querySelector('.brief-q.is-next .brief-chip');
        if (next) setTimeout(() => next.focus({ preventScroll: true }), 600);
      });
    });

    tg.addEventListener('click', () => {
      const done = () => { root.querySelector('[data-copied]').hidden = false; };
      try { navigator.clipboard?.writeText(text()).then(done, () => {}); } catch (e) {}
    });
    render();
  })();
</script>

<style is:global>
  .brief { padding: 5rem 0; border-top: 1px solid rgba(255, 176, 0, 0.25);
    background: radial-gradient(ellipse 70% 80% at 85% 30%, rgba(255, 176, 0, 0.1), transparent 70%), #121214; }
  .brief-grid { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: 3rem; align-items: start; }
  .brief-copy { position: sticky; top: 2rem; min-width: 0; }
  .brief h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.08; margin: 0 0 1.25rem; text-wrap: balance; }
  .brief-due { color: var(--accent-lightest); }
  .brief-lead { font-size: 1.1rem; }
  .brief-note { font-size: 0.95rem; padding-left: 0.9rem; border-left: 2px solid var(--accent); }
  .brief-direct { font-size: 0.95rem; }
  .brief-direct a { color: #fff; }
  .brief-card { scroll-margin-top: 90px; min-width: 0; padding: 1.5rem; border: 1px solid rgba(255, 209, 102, 0.35); border-radius: 12px;
    background: rgba(24, 24, 26, 0.92); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45); display: grid; gap: 1.1rem; }
  .brief-q { border: 0; margin: 0; padding: 0; min-width: 0; }
  .brief-q { transition: opacity 0.2s; }
  .brief-q.is-next legend::after { content: ' ←'; color: var(--accent); }
  .brief-q.is-next .brief-chip { border-color: rgba(255, 209, 102, 0.55); }
  .brief-card.arrived { animation: arrived 1.2s ease-out; }
  @keyframes arrived { 0% { box-shadow: 0 0 0 0 rgba(255, 176, 0, 0.55), 0 20px 60px rgba(0, 0, 0, 0.45); }
    100% { box-shadow: 0 0 0 18px rgba(255, 176, 0, 0), 0 20px 60px rgba(0, 0, 0, 0.45); } }
  .btn.is-ready { box-shadow: 0 0 0 4px rgba(255, 176, 0, 0.25), 0 0 28px var(--accent-glow); }
  @media (prefers-reduced-motion: reduce) { .brief-card.arrived { animation: none; } }
  .brief-q legend { padding: 0; margin-bottom: 0.55rem; color: #fff; font-weight: 700; font-size: 0.95rem; }
  .brief-opts { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .brief-chip { font: 600 0.92rem/1.2 var(--sans); color: rgba(255, 255, 255, 0.86); background: transparent; cursor: pointer;
    padding: 0.5rem 0.9rem; border: 1px solid var(--line); border-radius: 999px; transition: border-color 0.15s, background 0.15s, color 0.15s; }
  .brief-chip:hover { border-color: rgba(255, 209, 102, 0.6); }
  .brief-chip[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .brief-chip:focus-visible { outline: 2px solid var(--accent-lightest); outline-offset: 2px; }
  .brief-existing { margin: -0.4rem 0 0; font-size: 0.9rem; color: var(--accent-lightest); }
  .brief-link { display: grid; gap: 0.45rem; font-weight: 700; color: #fff; font-size: 0.95rem; }
  .brief-link em { font-style: normal; font-weight: 400; color: var(--muted); }
  .brief-link input { width: 100%; padding: 0.65rem 0.8rem; border-radius: 8px; border: 1px solid var(--line); background: #0d0d0f;
    color: #fff; font: 400 1rem var(--sans); }
  .brief-link input:focus { outline: none; border-color: var(--accent); }
  .brief-preview { display: grid; gap: 0.45rem; }
  .brief-preview span { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .brief-preview pre { margin: 0; padding: 0.9rem 1rem; max-height: 13.5rem; overflow: auto; white-space: pre-wrap; word-break: break-word;
    border-radius: 8px; border: 1px dashed rgba(255, 255, 255, 0.16); background: #0d0d0f; color: rgba(227, 227, 227, 0.85);
    font: 400 0.84rem/1.55 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .brief-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .brief-copied { margin: -0.4rem 0 0; font-size: 0.9rem; color: #d4f7a6; }
  .dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; pointer-events: none;
    padding: 0 max(1rem, env(safe-area-inset-right, 0px)) calc(1rem + env(safe-area-inset-bottom, 0px)) max(1rem, env(safe-area-inset-left, 0px));
    transform: translateY(calc(100% + 1rem)); transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .dock.on { transform: none; }
  .dock-in { pointer-events: auto; max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center; gap: 0.6rem 1.4rem; padding: 0.75rem 0.8rem 0.75rem 1.2rem; border-radius: 14px;
    border: 1px solid rgba(255, 209, 102, 0.45); background: rgba(20, 18, 14, 0.9); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(0, 0, 0, 0.4); }
  .dock-meta { margin: 0; display: grid; line-height: 1.25; }
  .dock-meta span { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
  .dock-meta strong { color: var(--accent-lightest); font-size: 1rem; white-space: nowrap; }
  .dock-ask { display: flex; align-items: center; gap: 0.5rem 0.9rem; min-width: 0; padding-left: 1.4rem; border-left: 1px solid rgba(255, 255, 255, 0.12); }
  .dock-q { margin: 0; color: #fff; font-weight: 700; white-space: nowrap; }
  .dock-opts { display: flex; gap: 0.45rem; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .dock-opts::-webkit-scrollbar { display: none; }
  .dock-chip, .dock-next, .dock-go { flex: none; font: 600 0.88rem/1.2 var(--sans); cursor: pointer; padding: 0.48rem 0.85rem; border-radius: 999px;
    border: 1px solid rgba(255, 209, 102, 0.4); background: transparent; color: rgba(255, 255, 255, 0.9); transition: border-color 0.15s, background 0.15s; }
  .dock-chip:hover { border-color: var(--accent); background: rgba(255, 176, 0, 0.1); }
  .dock-chip[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .dock-next, .dock-go { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .dock-go { box-shadow: 0 0 22px var(--accent-glow); }
  .dock-chip:focus-visible, .dock-next:focus-visible, .dock-go:focus-visible, .dock-close:focus-visible { outline: 2px solid var(--accent-lightest); outline-offset: 2px; }
  .dock-step { display: flex; align-items: center; gap: 0.55rem; color: var(--muted); font: 600 0.78rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .dock-segs { display: flex; gap: 3px; }
  .dock-segs i { width: 14px; height: 3px; border-radius: 2px; background: rgba(255, 255, 255, 0.18); transition: background 0.2s; }
  .dock-segs i.on { background: var(--accent); }
  .dock-close { width: 34px; height: 34px; border-radius: 50%; border: 0; background: transparent; color: var(--muted); font-size: 1.35rem; line-height: 1; cursor: pointer; }
  .dock-close:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
  @media (max-width: 860px) {
    .dock { padding-left: 0.6rem; padding-right: 0.6rem; padding-bottom: calc(0.6rem + env(safe-area-inset-bottom, 0px)); }
    .dock-in { grid-template-columns: minmax(0, 1fr) auto auto; gap: 0.5rem 0.6rem; padding: 0.65rem 0.4rem 0.75rem 0.9rem; }
    .dock-meta { display: block; }
    .dock-meta span { font-size: 0.68rem; }
    .dock-meta strong { display: block; font-size: 0.92rem; }
    .dock-ask { grid-column: 1 / -1; grid-row: 2; padding-left: 0; border-left: 0; flex-direction: column; align-items: stretch; gap: 0.4rem; }
    .dock-q { font-size: 0.9rem; }
    .dock-segs { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .dock { transition: none; } }
  @media (max-width: 860px) {
    .brief { padding: 3.5rem 0; }
    .brief-grid { grid-template-columns: 1fr; gap: 1.75rem; }
    .brief-copy { position: static; }
    .brief-card { padding: 1.1rem; }
  }
</style>
