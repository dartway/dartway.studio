---
/** U90 screens recreated from the app design (dw_studio/u90), texts in the page's language. Sizes in em = app points / 16. */
const { screen = 'today', lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const T = ru ? {
  cycle: 'Цикл 1 · Снижение веса · День 34 из 90',
  score: 'Оценка дня', eaten: 'Съедено', active: 'Активность', kcal: 'ккал', left: 'ккал осталось',
  track: 'В графике', trackNote: 'Хороший день', log: 'Журнал',
  actions: ['Фото', 'Галерея', 'Голос', 'Текст', 'Избранное'],
  ml: 'мл', waiting: 'Ждут подтверждения', check: 'Проверить',
  meal1: 'Яйца, тост с авокадо, томаты', meal1m: '≈ 486 ккал · 27 г белка',
  meal2: 'Латте 300 мл, банан', meal2m: '≈ 225 ккал · 8 г белка',
  tabs: ['Сегодня', 'Круг', 'Прогресс', 'Чаты'],
  breakfast: 'Завтрак · 9:40', recognized: 'Распознано по фото — проверьте порцию и подтвердите',
  dish: 'Яичница, тост с авокадо, черри', protein: 'г белка', g: 'г',
  items: [['Яичница', 110], ['Тост цельнозерновой', 45], ['Авокадо', 70], ['Томаты черри', 80], ['Масло для жарки', 40]],
  portion: 'Порция', drag: 'Тяните — пересчитается всё блюдо', edit: 'Изменить состав', confirm: 'Подтвердить и поделиться',
  progress: 'Прогресс', summary: 'Итоги', weight: 'Вес', waist: 'Талия', kg: 'кг', cm: 'см', adherence: 'Соблюдение плана', streak: 'Дней подряд', days: 'дн.',
  start: 'Старт', day34: 'День 34', here: 'Вы здесь', day90: 'День 90', onPlan: 'По плану',
  weightProgress: 'Динамика веса', ranges: ['7 дней', '30 дней', '90 дней', 'Все'], day5: 'День 5',
  current: 'Сейчас', forecast: 'Прогноз',
} : {
  cycle: 'Cycle 1 · Lose weight · Day 34 of 90',
  score: 'Day Score', eaten: 'Eaten', active: 'Active', kcal: 'kcal', left: 'kcal left',
  track: 'On track', trackNote: 'Good day · Keep going', log: 'Log',
  actions: ['Snap', 'Gallery', 'Voice', 'Type', 'Favorites'],
  ml: 'ml', waiting: 'Waiting for your OK', check: 'Check',
  meal1: 'Eggs, avocado toast, tomatoes', meal1m: '≈ 486 kcal · 27 g protein · 9:40',
  meal2: 'Latte 300 ml, banana', meal2m: '≈ 225 kcal · 8 g protein · 12:15',
  tabs: ['Today', 'Circle', 'Progress', 'Chats'],
  breakfast: 'Breakfast · 9:40', recognized: 'Recognized from photo — check the portion and confirm',
  dish: 'Fried eggs, avocado toast, cherry tomatoes', protein: 'g protein', g: 'g',
  items: [['Fried eggs', 110], ['Toast, whole grain', 45], ['Avocado', 70], ['Cherry tomatoes', 80], ['Butter for frying', 40]],
  portion: 'Portion', drag: 'Drag — the whole dish rescales', edit: 'Edit items', confirm: 'Confirm and share',
  progress: 'Progress', summary: 'Summary', weight: 'Weight', waist: 'Waist', kg: 'kg', cm: 'cm', adherence: 'Plan adherence', streak: 'Streak', days: 'days',
  start: 'Start', day34: 'Day 34', here: 'You are here', day90: 'Day 90', onPlan: 'On plan',
  weightProgress: 'Weight progress', ranges: ['7 days', '30 days', '90 days', 'All'], day5: 'Day 5',
  current: 'Current', forecast: 'Forecast',
};

const ico = (d: string, extra = '') => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" ${extra}>${d}</svg>`;
const I = {
  bell: ico('<path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20.5a2 2 0 0 0 4 0"/>'),
  flame: ico('<path d="M12 3c1 3.5 5 5.5 5 10a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5.3 1.5 1 2.5 2 3 0-3 0-5.5 1-8.5z"/>'),
  pulse: ico('<path d="M2 12h4l2-5 4 11 3-8 2 2h5"/>'),
  camera: ico('<path d="M4 8h3l2-2.5h6L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>'),
  image: ico('<rect x="4" y="4" width="16" height="16" rx="2.5"/><circle cx="9.5" cy="9.5" r="1.5"/><path d="m20 15-4.5-4.5L6 20"/>'),
  mic: ico('<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/>'),
  type: ico('<path d="M5 6V4.5h14V6M12 4.5v15M9 19.5h6"/>'),
  star: ico('<path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>'),
  drop: ico('<path d="M12 3.5s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>'),
  glass: ico('<path d="M6 4h12l-1.5 16h-9z"/><path d="M6.6 10h10.8"/>'),
  home: ico('<path d="M4 11 12 4l8 7v9h-5v-6h-6v6H4z"/>'),
  people: ico('<circle cx="9" cy="8.5" r="3.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M15.5 5.2a3.5 3.5 0 0 1 0 6.6M17.5 14.4c2 .8 3.5 2.9 3.5 5.6"/>'),
  trend: ico('<path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/>'),
  chat: ico('<path d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5z"/>'),
  close: ico('<path d="M6 6l12 12M18 6 6 18"/>'),
  chev: ico('<path d="m9 6 6 6-6 6"/>'),
  bag: ico('<path d="M5 9h14l-1.5 11h-11z"/><path d="M9 9V7a3 3 0 0 1 6 0v2"/>'),
  ruler: ico('<rect x="2.5" y="8.5" width="19" height="7" rx="1.5" transform="rotate(-45 12 12)"/><path d="m8.5 10.5 1.5 1.5M11 8l1.5 1.5M13.5 5.5 15 7"/>'),
  cal: ico('<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M8 3v4M16 3v4"/><path d="m9 15 2 2 4-4"/>'),
  fire: ico('<path d="M12 3c1 3.5 5 5.5 5 10a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5.3 1.5 1 2.5 2 3 0-3 0-5.5 1-8.5z"/>'),
};
// The app's mascot, drawn: a red heart with a face
const mascot = `<svg viewBox="0 0 64 60"><defs><radialGradient id="u90h" cx="40%" cy="30%" r="75%"><stop offset="0" stop-color="#ff6f73"/><stop offset=".6" stop-color="#ef2f3c"/><stop offset="1" stop-color="#c81428"/></radialGradient></defs><path d="M32 57C14 45 4 34 4 20 4 10 11 4 19.5 4 25 4 29.5 7 32 11.5 34.5 7 39 4 44.5 4 53 4 60 10 60 20c0 14-10 25-28 37z" fill="url(#u90h)"/><ellipse cx="23" cy="26" rx="3.6" ry="4.6" fill="#1b1b2e"/><ellipse cx="41" cy="26" rx="3.6" ry="4.6" fill="#1b1b2e"/><circle cx="24.2" cy="24.4" r="1.3" fill="#fff"/><circle cx="42.2" cy="24.4" r="1.3" fill="#fff"/><path d="M27 34c2.8 3 7.2 3 10 0" stroke="#1b1b2e" stroke-width="2.2" fill="none" stroke-linecap="round"/><ellipse cx="16" cy="33" rx="3.5" ry="2" fill="#ff9aa6" opacity=".7"/><ellipse cx="48" cy="33" rx="3.5" ry="2" fill="#ff9aa6" opacity=".7"/></svg>`;
const active = screen === 'progress' ? 2 : 0;
const tabIcons = [I.home, I.people, I.trend, I.chat];
---
<div class:list={['u90', `u90-${screen}`]}>
  {screen === 'today' && (
    <>
      <header class="u-head">
        <span class="u-logo">U<b>9</b>0</span>
        <span class="u-bell"><i set:html={I.bell} /><em>5</em></span>
        <span class="u-avatar">A</span>
      </header>
      <div class="u-cycle"><span>{T.cycle}</span><i style="--p:38%"></i></div>
      <section class="u-card u-score">
        <div class="u-score-main">
          <p class="u-h">{T.score}</p>
          <p class="u-big"><b>60</b>/100</p>
        </div>
        <ul class="u-score-side">
          <li><i class="c-red" set:html={I.flame} /><span><small>{T.eaten}</small><b>918</b> {T.kcal}</span></li>
          <li><i class="c-blue" set:html={I.pulse} /><span><small>{T.active}</small><b>188</b> {T.kcal}</span></li>
          <li><i class="u-ring"></i><span><b>692</b> {T.left}</span></li>
        </ul>
        <p class="u-score-foot"><span class="u-dot"></span><b>{T.track}</b><span class="u-mute">{T.trackNote}</span><span class="u-log">{T.log} <i set:html={I.chev} /></span></p>
      </section>
      <div class="u-actions">
        {[I.camera, I.image, I.mic, I.type, I.star].map((icon, i) => (
          <span class:list={['u-act', { on: i === 0 }]}><i set:html={icon} />{T.actions[i]}</span>
        ))}
      </div>
      <section class="u-card u-water">
        <i class="c-blue" set:html={I.drop} /><b>150 {T.ml}</b>
        <span class="u-track"><span style="width:44%"></span><em style="left:44%"></em></span>
        <span class="u-cup" set:html={I.glass} />
      </section>
      <p class="u-row-title"><b>{T.waiting}</b><span>2</span></p>
      <section class="u-wait">
        <span class="u-plate-mini" set:html={`<svg viewBox="0 0 40 40"><rect width="40" height="40" fill="#b9814d"/><circle cx="20" cy="20" r="15" fill="#fff"/><circle cx="14" cy="16" r="5" fill="#fff6dc"/><circle cx="14" cy="16" r="2.2" fill="#f6b21a"/><rect x="20" y="17" width="10" height="9" rx="2" fill="#d9a35c"/><circle cx="25" cy="21.5" r="3" fill="#8cc152"/><circle cx="17" cy="27" r="1.8" fill="#e5302b"/></svg>`} />
        <span class="u-wait-t"><b>{T.meal1}</b><small>{T.meal1m}</small></span>
        <span class="u-btn">{T.check}</span>
      </section>
      <section class="u-wait">
        <span class="u-mic-mini" set:html={I.mic} />
        <span class="u-wait-t"><b>{T.meal2}</b><small>{T.meal2m}</small></span>
        <span class="u-btn">{T.check}</span>
      </section>
    </>
  )}

  {screen === 'meal' && (
    <>
      <div class="u-backdrop"></div>
      <div class="u-sheet">
        <span class="u-grab"></span>
        <header class="u-sheet-head">
          <span><b class="u-serif">{T.breakfast}</b><small>{T.recognized}</small></span>
          <i class="u-x" set:html={I.close} />
        </header>
        <div class="u-photo" set:html={`<svg viewBox="0 0 335 170" preserveAspectRatio="xMidYMid slice"><rect width="335" height="170" fill="#b07a48"/><g stroke="#9c6a3c" stroke-width="2" opacity=".5"><path d="M0 30h335M0 75h335M0 120h335M0 160h335"/></g><ellipse cx="170" cy="92" rx="150" ry="112" fill="#f4f1ec"/><ellipse cx="170" cy="92" rx="132" ry="98" fill="#fff"/><ellipse cx="96" cy="68" rx="34" ry="30" fill="#fffaf0"/><circle cx="96" cy="70" r="14" fill="#f6b21a"/><ellipse cx="128" cy="128" rx="30" ry="26" fill="#fffaf0"/><circle cx="128" cy="130" r="13" fill="#f6b21a"/><path d="M150 40c6-6 12-6 18-2" stroke="#3f8a3a" stroke-width="5" stroke-linecap="round"/><rect x="186" y="60" width="78" height="72" rx="14" fill="#d79a52" transform="rotate(-8 225 96)"/><rect x="196" y="70" width="58" height="52" rx="10" fill="#e9c27f" transform="rotate(-8 225 96)"/><ellipse cx="226" cy="94" rx="22" ry="17" fill="#8cc152"/><circle cx="220" cy="90" r="2" fill="#3f6b2a"/><circle cx="232" cy="98" r="2" fill="#3f6b2a"/><circle cx="160" cy="150" r="9" fill="#e5302b"/><circle cx="180" cy="142" r="10" fill="#e5302b"/><circle cx="202" cy="136" r="9" fill="#e5302b"/><path d="M178 133l2-5M200 128l2-4" stroke="#3f8a3a" stroke-width="2"/></svg>`} />
        <section class="u-dish">
          <header><b class="u-serif">{T.dish}</b><span><b class="c-orange">486 {T.kcal}</b><b class="c-violet">27 {T.protein}</b></span></header>
          <ul>{T.items.map(([n, w]) => <li><span>{n}</span><span>{w} {T.g}</span></li>)}</ul>
          <div class="u-portion"><b>{T.portion}</b><b>345 {T.g}</b></div>
          <span class="u-track pink"><span style="width:50%"></span><em style="left:50%"></em></span>
          <p class="u-scale"><span>×0.5</span><span>{T.drag}</span><span>×1.5</span></p>
          <span class="u-outline">{T.edit}</span>
        </section>
        <footer class="u-sheet-foot"><span class="u-fav" set:html={I.star} /><span class="u-cta">{T.confirm}</span></footer>
      </div>
    </>
  )}

  {screen === 'progress' && (
    <>
      <header class="u-head">
        <b class="u-serif u-title">{T.progress}</b>
        <span class="u-bell"><i set:html={I.bell} /><em>5</em></span>
        <span class="u-avatar">A</span>
      </header>
      <p class="u-sec u-serif">{T.summary}</p>
      <section class="u-card u-sum">
        <div class="u-tiles">
          <span><i set:html={I.bag} /><b>−2.4<small> {T.kg}</small></b><small>{T.weight}</small></span>
          <span><i set:html={I.ruler} /><b>−3.0<small> {T.cm}</small></b><small>{T.waist}</small></span>
          <span><i set:html={I.cal} /><b>78%</b><small>{T.adherence}</small></span>
          <span><i set:html={I.fire} /><b>6<small> {T.days}</small></b><small>{T.streak}</small></span>
        </div>
        <p class="u-onplan"><span class="u-dot"></span>{T.onPlan}</p>
        <div class="u-line"><span style="width:38%"></span><em style="left:38%"></em><i style="left:0"></i><i style="left:100%"></i></div>
        <p class="u-line-l"><span>{T.start}</span><span><b>{T.day34}</b><small>{T.here}</small></span><span>{T.day90}</span></p>
      </section>
      <p class="u-sec u-serif">{T.weightProgress}</p>
      <section class="u-card u-chart">
        <div class="u-seg">{T.ranges.map((r, i) => <span class:list={[{ on: i === 1 }]}>{r}</span>)}</div>
        <span class="u-now">66.8 {T.kg}</span>
        <svg viewBox="0 0 300 110" preserveAspectRatio="none" class="u-plot">
          <defs><linearGradient id="u90a" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#F2185A" stop-opacity=".32"/><stop offset="1" stop-color="#F2185A" stop-opacity=".04"/></linearGradient></defs>
          <path d="M8 28 L28 31 L48 35 L68 38 L88 41 L108 46 L108 110 L8 110 Z" fill="url(#u90a)"/>
          <path d="M8 28 L28 31 L48 35 L68 38 L88 41 L108 46" stroke="#F2185A" stroke-width="2.5" fill="none" vector-effect="non-scaling-stroke"/>
          <path d="M108 46 L290 98" stroke="#8a93b0" stroke-width="1.6" stroke-dasharray="5 5" fill="none" vector-effect="non-scaling-stroke"/>
        </svg>
        <p class="u-axis"><span>{T.day5}</span><span>{T.day90}</span></p>
        <div class="u-stats"><span><small>{T.start}</small><b>69.2 {T.kg}</b></span><span><small>{T.current}</small><b>66.8 {T.kg}</b></span><span><small>{T.forecast}</small><b>62.0 {T.kg}</b></span></div>
      </section>
    </>
  )}

  {screen !== 'meal' && (
    <nav class="u-tabs">
      {T.tabs.map((tab, i) => (
        <>
          {i === 2 && <span class="u-mascot" set:html={mascot} />}
          <span class:list={['u-tab', { on: i === active }]}><i set:html={tabIcons[i]} />{tab}{i === 3 && <em>2</em>}</span>
        </>
      ))}
    </nav>
  )}
</div>

<style>
  .u90 {
    --pink: #F2185A; --pink-50: #FFF5F8; --pink-200: #F7DCE6; --ink: #101C4E; --ink-5: #56679B; --ink-3: #8A93B0;
    --green: #179C6B; --red: #DC312D; --violet: #783CD9; --blue: #2E6FE8; --orange: #F07A1A; --line: #E7E9F1;
    position: relative; height: 100%; overflow: hidden; background: #fff; color: var(--ink);
    font: 400 calc(100cqw / 23.4375) / 1.3 'Figtree', system-ui, -apple-system, 'Segoe UI', sans-serif;
    padding: 0.6em 1.25em 0; text-align: left; letter-spacing: 0; -webkit-font-smoothing: antialiased;
  }
  .u90 :global(svg) { display: block; width: 100%; height: 100%; }
  .u90 p { margin: 0; }
  :where(.u90) p { color: inherit; }
  .u90 i { display: inline-block; font-style: normal; }
  .u90 small { font-size: 0.8em; }
  .u-serif { font-family: 'Playfair Display', Georgia, 'Times New Roman', serif; font-weight: 700; letter-spacing: -0.01em; }
  .c-red { color: var(--red); } .c-blue { color: var(--blue); } .c-orange { color: var(--orange); } .c-violet { color: var(--violet); }

  .u-head { display: flex; align-items: center; gap: 1em; height: 3em; }
  .u-logo { font-size: 1.75em; font-weight: 600; letter-spacing: -0.03em; margin-right: auto; }
  .u-logo b { font-weight: 600; color: var(--pink); }
  .u-title { font-size: 2.1em; margin-right: auto; }
  .u-bell { position: relative; width: 1.5em; height: 1.5em; }
  .u-bell i { width: 100%; height: 100%; }
  .u-bell em, .u-tab em { position: absolute; top: -0.35em; right: -0.45em; min-width: 1.05em; height: 1.05em; border-radius: 1em; background: var(--pink); color: #fff; font: 700 0.62em/1.05em 'Figtree', system-ui, sans-serif; text-align: center; border: 0.12em solid #fff; }
  .u-avatar { width: 2.1em; height: 2.1em; border-radius: 50%; background: linear-gradient(135deg, #d8b4a0, #8c6a5c); color: #fff; font-weight: 700; display: grid; place-items: center; font-size: 0.95em; }

  .u-cycle { position: relative; padding: 0.55em 0 0.6em; font-weight: 600; font-size: 0.92em; border-bottom: 0.13em solid var(--line); }
  .u-cycle i { position: absolute; left: 0; bottom: -0.13em; width: var(--p); height: 0.13em; background: var(--green); }

  .u-card { border: 0.07em solid var(--line); border-radius: 1.1em; background: #fff; }
  .u-score { margin-top: 1.3em; padding: 1em 1em 0.9em; display: grid; grid-template-columns: 1fr 1fr; column-gap: 0.8em; }
  .u-h { font-weight: 700; font-size: 1.05em; }
  .u-score-main { border-right: 0.07em solid var(--line); padding-right: 0.6em; background: radial-gradient(circle at 50% 62%, rgba(23,156,107,0.13), transparent 62%); }
  .u-big { margin-top: 1.1em !important; text-align: center; font-size: 1.15em; font-weight: 700; color: var(--ink); }
  .u-big b { font-size: 2.9em; color: var(--green); letter-spacing: -0.03em; line-height: 1; }
  .u-score-side { list-style: none; margin: 0; padding: 0; display: grid; }
  .u-score-side li { display: flex; align-items: center; gap: 0.7em; padding: 0.45em 0; border-bottom: 0.07em solid var(--line); font-size: 0.82em; }
  .u-score-side li:last-child { border-bottom: 0; }
  .u-score-side i { width: 1.6em; height: 1.6em; flex: none; }
  .u-score-side small { display: block; color: var(--ink-5); font-size: 0.9em; }
  .u-score-side b { font-size: 1.25em; }
  .u-ring { border-radius: 50%; background: conic-gradient(var(--red) 0 43%, #f6d4d3 0); -webkit-mask: radial-gradient(circle, transparent 52%, #000 54%); mask: radial-gradient(circle, transparent 52%, #000 54%); }
  .u-score-foot { grid-column: 1 / -1; display: flex; align-items: center; gap: 0.45em; margin-top: 0.8em !important; font-size: 0.8em; }
  .u-score-foot b { color: var(--green); white-space: nowrap; }
  .u-score-foot .u-mute { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .u-dot { width: 0.5em; height: 0.5em; border-radius: 50%; background: var(--green); flex: none; }
  .u-mute { color: var(--ink-5); }
  .u-log { margin-left: auto; display: inline-flex; align-items: center; gap: 0.2em; font-weight: 600; }
  .u-log i { width: 1em; height: 1em; }

  .u-actions { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.55em; margin-top: 1em; }
  .u-act { display: grid; justify-items: center; gap: 0.45em; font-size: 0.74em; font-weight: 600; white-space: nowrap; }
  .u-act i { width: 100%; aspect-ratio: 1; border: 0.09em solid var(--line); border-radius: 0.95em; color: var(--pink); padding: 1.05em; box-shadow: 0 0.2em 0.6em rgba(16,28,78,0.05); }
  .u-act.on i { background: var(--pink); color: #fff; border-color: var(--pink); box-shadow: 0 0.35em 0.9em rgba(242,24,90,0.35); }

  .u-water { margin-top: 1em; display: flex; align-items: center; gap: 0.75em; padding: 0.8em 1em; }
  .u-water > i { width: 1.25em; height: 1.25em; }
  .u-water > b { font-size: 0.95em; white-space: nowrap; }
  .u-track { position: relative; flex: 1; height: 0.38em; border-radius: 1em; background: #E6EDFC; display: block; }
  .u-track span { position: absolute; inset: 0 auto 0 0; border-radius: 1em; background: var(--blue); }
